          container.appendChild(div);
        });
      });
    }

    function useHistory(ssid, pass) { document.getElementById('ssid').value = ssid; document.getElementById('sta_pass').value = pass; }
    function deleteHistory(index) { fetch('/delete-history', {method:'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: 'index='+index}).then(() => { loadHistory(); }); }
    function clearHistory() { fetch('/clear-history', {method:'POST'}).then(() => { loadHistory(); }); }
    function scanWiFi() {
      var container = document.getElementById('scanResults');
      container.innerHTML = '<p class="small">Memindai...</p>';
      fetch('/scan').then(r => r.json()).then(networks => {
        container.innerHTML = ''; if (networks.length === 0) { container.innerHTML = '<p class="small">Tidak ada WiFi</p>'; return; }
