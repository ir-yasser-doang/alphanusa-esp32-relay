          var div = document.createElement('div'); div.className = 'wifi-item';
          div.innerHTML = '<span>' + n.ssid + '</span><span class="small">' + n.rssi + ' dBm</span>';
          div.onclick = function() { document.getElementById('ssid').value = n.ssid; };
          container.appendChild(div);
        });
      });
    }

    loadStatus(); loadHistory(); loadEventLog();
    setInterval(loadStatus, 5000);
  </script>
