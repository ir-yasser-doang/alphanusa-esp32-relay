  <script>
    function togglePw(id, el) { var input = document.getElementById(id); if (input.type === 'password') { input.type = 'text'; el.textContent = '🙈'; } else { input.type = 'password'; el.textContent = '👁'; } }
    
    function loadStatus() {
      fetch('/status').then(r => r.json()).then(d => {
        document.getElementById('relayStatus').textContent = d.relay ? 'ON' : 'OFF';
