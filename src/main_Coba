        container.innerHTML = '';
        list.forEach(item => {
          var div = document.createElement('div'); div.className = 'history-item';
          var badge = item.status === 'success' ? '<span class="badge badge-success">OK</span>' : '<span class="badge badge-failed">GAGAL</span>';
          div.innerHTML = '<div class="history-info" onclick="useHistory(\'' + item.ssid + '\', \'' + item.pass + '\')"><div class="history-ssid">' + item.ssid + badge + '</div></div><button class="btn-off btn-xs" onclick="deleteHistory(' + item.index + ')" style="background:#f44336; color:white;">Hapus</button>';
          container.appendChild(div);
        });
