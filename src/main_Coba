  Serial.println("[WEB] Web Server siap di port 80");

  addEventLog("Sistem siap");
  Serial.println("Sistem siap!");
}

// ===== Loop =====
void loop() {
  server.handleClient();

  // AUTO RECONNECT WIFI
  if (WiFi.status() != WL_CONNECTED && staSSID.length() > 0) {
    if (millis() - lastWiFiReconnectAttempt > 15000) {
      Serial.println("[WIFI] Koneksi terputus, mencoba reconnect otomatis...");
      addEventLog("Mencoba reconnect WiFi...");
      WiFi.disconnect();
      
      preferences.begin("wifi-sta", true);
      String savedPass = preferences.getString("pass", "");
      preferences.end();
      
      WiFi.begin(staSSID.c_str(), savedPass.c_str());
      lastWiFiReconnectAttempt = millis();
    }
  }

  if (timeClient.update()) {
    if (!sudahSinkronWaktu) {
      sudahSinkronWaktu = true;
      Serial.println("[NTP] Waktu berhasil disinkronisasi!");
      addEventLog("Waktu NTP tersinkronisasi");
    }
  }

  if (WiFi.status() == WL_CONNECTED && !staConnected) {
    staConnected = true;
    staIP = WiFi.localIP().toString();
    staRSSI = WiFi.RSSI();
    addEventLog("STA terhubung, IP: " + staIP);
  } else if (WiFi.status() != WL_CONNECTED && staConnected) {
    staConnected = false;
    addEventLog("STA terputus");
  }

  if (millis() - lastInternetCheck >= INTERNET_CHECK_INTERVAL) {
    lastInternetCheck = millis();
    if (staConnected) checkInternet();
    else internetAvailable = false;
  }

  if (staConnected && internetAvailable) {
    if (!mqttClient.connected()) {
      mqttConnected = false;
      if (millis() - lastMqttReconnect >= MQTT_RECONNECT_INTERVAL) {
        lastMqttReconnect = millis();
        Serial.print("[MQTT] Mencoba koneksi... ");
        String lwtTopic = "unit/" + mqttDeviceId + "/status";
        
        if (mqttClient.connect(mqttClientId.c_str(), lwtTopic.c_str(), 1, true, "offline")) {
          Serial.println("Terhubung!");
          mqttConnected = true;
          lastMqttConnectedTime = millis();
          mqttClient.publish(lwtTopic.c_str(), "online", true);
          
          String subTopic = "unit/" + mqttDeviceId + "/lease/set";
          mqttClient.subscribe(subTopic.c_str(), 1);
          Serial.print("[MQTT] Subscribe: "); Serial.println(subTopic);
          addEventLog("MQTT terhubung");
          
          publishRelayStatus();
        } else {
          Serial.print("Gagal, rc="); Serial.println(mqttClient.state());
        }
      }
    } else {
      mqttConnected = true;
      mqttClient.loop();
    }
  }

  evaluateRelayState();
}

// ===== MQTT Callback =====
void mqttCallback(char* topic, byte* payload, unsigned int length) {
  Serial.print("[MQTT] Pesan masuk: ");
  Serial.println(topic);

  JsonDocument doc;
  DeserializationError error = deserializeJson(doc, payload, length);
  if (error) {
    Serial.print("[MQTT] Gagal parse JSON: "); Serial.println(error.c_str());
    return;
  }

  String expectedTopic = "unit/" + mqttDeviceId + "/lease/set";
  if (String(topic) == expectedTopic) {
    lastActiveUntil = doc["active_until"] | 0;
    graceSeconds = doc["grace_s"] | 0;
    overrideMode = doc["override"] | "AUTO";
    lastRev = doc["rev"] | 0;

    Serial.printf("Data -> Until: %lu, Grace: %lu, Mode: %s\n", lastActiveUntil, graceSeconds, overrideMode.c_str());
    addEventLog("MQTT perintah: mode=" + overrideMode);
    
    evaluateRelayState();

    JsonDocument stateDoc;
    stateDoc["rev"] = lastRev;
    stateDoc["relay_on"] = relayOn;
    stateDoc["reason"] = (overrideMode != "AUTO") ? "override" : "lease_active";
    stateDoc["fw"] = "2.0.0";
    
    String statePayload;
    serializeJson(stateDoc, statePayload);
    String stateTopic = "unit/" + mqttDeviceId + "/lease/state";
    mqttClient.publish(stateTopic.c_str(), statePayload.c_str());
  }
}

// ===== Evaluasi Relay =====
void evaluateRelayState() {
  bool shouldBeOn = false;
  unsigned long now = timeClient.getEpochTime();

  if (!sudahSinkronWaktu) return;
  if (lastActiveUntil == 0 && overrideMode == "AUTO") return;

  bool isOffline = !mqttConnected;
  unsigned long timeSinceLastConnect = millis() - lastMqttConnectedTime;
  
  if (isOffline && timeSinceLastConnect < FAILSAFE_TIMEOUT) {
    if (!relayOn) {
      Serial.println("[FAIL-SAFE] Koneksi terputus, memaksa relay ON selama 24 jam!");
      addEventLog("FAIL-SAFE: Relay dipaksa ON");
      setRelay(true);
    }
    return; 
  }

  if (overrideMode == "ON") {
    shouldBeOn = true;
  } else if (overrideMode == "OFF") {
    shouldBeOn = false;
  } else {
    unsigned long powerOffTime = lastActiveUntil + graceSeconds;
    if (now < powerOffTime) {
      shouldBeOn = true;
    } else {
      shouldBeOn = false;
    }
  }

  if (relayOn != shouldBeOn) {
    setRelay(shouldBeOn);
    publishRelayStatus();
  }
}

// ===== Publish Status =====
void publishRelayStatus() {
  if (!mqttClient.connected()) return;
  JsonDocument doc;
  doc["relay_on"] = relayOn;
  doc["reason"] = (overrideMode != "AUTO") ? "override" : "lease_active";
  
  String payload;
  serializeJson(doc, payload);
  String topic = "unit/" + mqttDeviceId + "/lease/state";
  mqttClient.publish(topic.c_str(), payload.c_str(), true);
}

